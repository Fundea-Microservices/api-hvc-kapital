PORT=3000

# Zona horaria del proceso Node. Debe ser siempre UTC: la API y la base de
# datos trabajan internamente en UTC sin importar en qué región de AWS (o
# máquina local) corran; la conversión a hora local se hace solo al mostrar
# los datos en el frontend.
TZ=UTC

DB_HOST='localhost'
DB_USER='user'
DB_PORT=1433
DB_PASSWORD='****'
DB_DATABASE='BD'
DB_TYPE='mssql'
JWT_SECRET='abc123'
# En segundos, no admite sufijos: joi valida esta variable como número.
TOKEN_EXPIRATION='3600'
PREFIX=v1

# Seed — Administradores iniciales (solo se usa en seed, nunca hardcodeado)
SEED_ADMIN_USERNAME=sysadmin
SEED_ADMIN_EMAIL=admin@sistema.com
SEED_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
SEED_ADMIN1_USERNAME=admin1
SEED_ADMIN1_EMAIL=admin1@sistema.com
SEED_ADMIN1_PASSWORD=CHANGE_ME_IN_PRODUCTION

# HMAC-SHA256 del PIN de autorización. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres. No reutilizar JWT_SECRET.
AUTH_CODE_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
# PINs de los usuarios seed (el seed los hashea; no se persisten en claro)
SEED_ADMIN_AUTH_CODE=CHANGE_ME
SEED_ADMIN1_AUTH_CODE=CHANGE_ME
# Llave hexadecimal para integración ERP (opcional, se omite si no está definida)
# SEED_ERP_KEY=AA8F9415004E3D7033D37A16E2DDCF0894F4B5D9C0FF3B0A77B9398AA572149C